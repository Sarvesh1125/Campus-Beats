{
  "name": "campus-connect",
  "version": "2.0.0",
  "description": "College Event Management System - Advanced DBMS project (Node.js + Express + MongoDB)",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "seed": "node scripts/seed.js",
    "test": "node tests/integration.js",
    "migrate": "node scripts/migrate.js",
    "recover-lock": "node scripts/recover-lock.js",
    "test:upgrades": "node tests/upgrades.js",
    "test:isolated": "node tests/local-mongo.js tests/all.js",
    "test:ui": "node tests/local-mongo.js tests/ui.js"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "mongoose": "^8.5.1",
    "nodemailer": "^10.0.15",
    "qr-scanner": "^1.4.2",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "mongodb-memory-server": "^11.3.0",
    "playwright": "^1.63.0"
  }
}
