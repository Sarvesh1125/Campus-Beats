MONGODB_URI=mongodb://127.0.0.1:27017/campus_connect
HOST=127.0.0.1
PORT=3000
# All event inputs/display use Asia/Kolkata; MongoDB dates are UTC.
APP_BASE_URL=http://localhost:3000
NODE_ENV=development
# console = development-only terminal reset links. smtp = actual email delivery.
PASSWORD_DELIVERY=console
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Campus Connect <no-reply@example.com>
# Integration tests only: never point this at the application database.
TEST_MONGODB_URI=mongodb://127.0.0.1:27017/campus_connect_test
